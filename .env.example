# Absolute path to this repository
# ROOT_PATH = ""

# Context7 — required. Used by query_ifcopenshell_docs to retrieve
# IfcOpenShell documentation at tool-creation time.
# CONTEXT7_API_KEY = ""

# Z.AI — required. Default BAML client (GLM 4.7) calls z.ai directly.
# Used to produce the paper results.
# Z_AI_API_KEY = ""

# OpenRouter — optional backup. If set, you can swap the `client` line in any
# baml function from `GLM_4_7` to `GLM_4_7_OpenRouter` to run the same model
# (z-ai/glm-4.7) via OpenRouter instead of z.ai directly.
# OPENROUTER_API_KEY = ""

# Optional BAML logging (set to "info" or "debug" to see the raw prompts)
# BAML_LOG = ""
