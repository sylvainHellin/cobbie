# Let's create the function to get list of IFC spaces
# I need to consider the function signature and what type of input it should accept

import ifcopenshell
import ifcopenshell.util.element
import ifcopenshell.util.shape
import ifcopenshell.util.placement
import ifcopenshell.util.geolocation
import ifcopenshell.util.system
import ifcopenshell.geom
import math
import json
from typing import Union, List, Dict, Any

def get_list_ifc_spaces(ifc_model: Union[str, ifcopenshell.file]) -> List[Any]:
    """
    Return a list of the IfcSpace from an ifc model.
    
    Args:
        ifc_model: Either a file path (string) to an IFC file or an already loaded ifcopenshell.file object
    
    Returns:
        List of IfcSpace entities from the IFC model
    """
    # Handle both file path and already loaded file object
    if isinstance(ifc_model, str):
        # If it's a string, assume it's a file path and open it
        ifc_file = ifcopenshell.open(ifc_model)
    elif hasattr(ifc_model, 'by_type'):
        # If it's already an IFC file object, use it directly
        ifc_file = ifc_model
    else:
        raise ValueError("ifc_model must be either a file path (string) or an ifcopenshell.file object")
    
    # Get all IfcSpace entities from the model
    ifc_spaces = ifc_file.by_type('IfcSpace')
    
    # Return as a list (by_type already returns a list-like object)
    return list(ifc_spaces)

# Test the function structure
print("Function created successfully!")
print(f"Function name: {get_list_ifc_spaces.__name__}")
print(f"Function docstring: {get_list_ifc_spaces.__doc__}")
```

