import ifcopenshell.util.geolocation
import ifcopenshell.util.system
import ifcopenshell.geom
import math
import json
from typing import Union, List, Dict, Any

def get_space_height(ifc_file_path: str, space_id: str) -> float:
    \"\"\"
    Retrieves the height of an IfcSpace element from an IFC model.

    This function first attempts to find the height from an IfcExtrudedAreaSolid
    representation. If not found, it falls back to calculating the height from
    the bounding box of the space's generated geometry using ifcopenshell.geom.

    Args:
        ifc_file_path (str): The path to the IFC file.
        space_id (str): The GlobalId (GUID) of the IfcSpace element.

    Returns:
        float: The height of the IfcSpace element.

    Raises:
        FileNotFoundError: If the specified IFC file does not exist.
        ValueError: If the IfcSpace with the given ID is not found,
                    if the provided ID does not correspond to an IfcSpace element,
                    or if its height cannot be determined from its geometry.
    \"\"\"
    try:
        model = ifcopenshell.open(ifc_file_path)
    except Exception as e:
        raise FileNotFoundError(f"Could not open IFC file at {ifc_file_path}: {e}")

    try:
        space = model.by_guid(space_id)
    except RuntimeError:
        raise ValueError(f"IfcSpace with ID '{space_id}' not found in the model.")

    if not space.is_a("IfcSpace"):
        raise ValueError(f"Element with ID '{space_id}' is not an IfcSpace element (it is an {space.is_a()}).")

    # Attempt 1: Check for IfcExtrudedAreaSolid directly
    if space.Representation:
        for representation in space.Representation.Representations:
            if representation.RepresentationType == "Body":
                for item in representation.Items:
                    if item.is_a("IfcExtrudedAreaSolid"):
                        return item.Depth

    # Attempt 2: Fallback to geometry generation and bounding box calculation
    try:
        settings = ifcopenshell.geom.settings()
        # settings.set(settings.USE_WORLD_COORDS, True) # Optional: ensures world coordinates for bbox, often default for products
        
        shape = ifcopenshell.geom.create_shape(settings, space)
        
        # The bounding box is a tuple (min_x, min_y, min_z, max_x, max_y, max_z)
        bbox = shape.bbox
        
        min_z = bbox[2]
        max_z = bbox[5]
        
        calculated_height = max_z - min_z
        
        if calculated_height > 0:
            return calculated_height
        else:
            raise ValueError(f"Calculated height for IfcSpace '{space_id}' (Name: {space.Name}) is non-positive: {calculated_height}. This might indicate an issue with the space's geometry or its definition.")

    except Exception as e:
        raise ValueError(f"Could not determine height for IfcSpace '{space_id}' (Name: {space.Name}). Failed to generate geometry or calculate bounding box: {e}")
""")' due to: TypeError: evaluate_python_code.<locals>.final_answer() got an unexpected keyword argument 'function_implementation'
