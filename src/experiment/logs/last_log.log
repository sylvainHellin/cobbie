import ifcopenshell
import ifcopenshell.util.element

def get_door_properties(ifc_file_path, door_identifier=None):
    """
    Retrieves the properties of doors in an IFC model.

    Args:
    - ifc_file_path (str): Path to the IFC file.
    - door_identifier (str or int, optional): Identifier for a specific door. Defaults to None.

    Returns:
    - dict: Dictionary containing door names as keys and their properties as values.
    """
    model = ifcopenshell.open(ifc_file_path)
    doors = model.by_type('IfcDoor')
    door_properties = {}
    for door in doors:
        if door_identifier is not None:
            if door.Name == door_identifier:
                psets = ifcopenshell.util.element.get_psets(door)
                door_properties[door.Name] = psets
                break
        else:
            psets = ifcopenshell.util.element.get_psets(door)
            door_properties[door.Name] = psets
    return door_properties

# Example usage
ifc_file_path = 'path_to_AC20-FZK-Haus.ifc'
print(get_door_properties(ifc_file_path))
